# Copy to .env and fill in locally. Never commit real values.
# Production values live in the Netlify and Supabase secret stores.

# Postgres (Supabase project "GenCut Creators"), server-only. Use the pooler URL on Netlify.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gencut_creators

# Supabase Auth (email-link sign-in). Both are safe in the browser; every table denies the public API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of media kits (gencut.ai/@handle once the domain is attached). Defaults to this deployment.
GENCUT_PUBLIC_URL=

# Instagram API with Instagram Login (Meta App Dashboard → Instagram → API setup with Instagram login).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# testers (until Meta App Review approves GenCut) | public
GENCUT_INSTAGRAM_ACCESS=testers

# Token encryption keys, newest first: "k1:<base64 of 32 random bytes>". Generate: openssl rand -base64 32
GENCUT_TOKEN_KEYS=
# Signs OAuth state. 32+ random characters. Generate: openssl rand -base64 48
GENCUT_STATE_SECRET=
# Keys the one-way daily visitor hash for media-kit visits and inquiry rate limits. 32+ random characters.
GENCUT_VISIT_SECRET=

# Optional: the assistant asks the fast model to route questions the parser does not recognise.
ANTHROPIC_API_KEY=
# Optional model overrides, e.g. GENCUT_MODEL_FAST=anthropic:claude-haiku-5-5
GENCUT_MODEL_FAST=

# GenCut staff who may see every referral lead with its email (/admin/referrals) and every
# sign-up (/admin/signups). Comma-separated.
GENCUT_ADMIN_EMAILS=
